# カーネルのエントリーから ExitBootServices までを TANEBI で実装。
global FB_BASE: u64 = 0;
global FB_SIZE: u64 = 0;
global FB_WIDTH: u64 = 0;
global FB_HEIGHT: u64 = 0;
global FB_STRIDE: u64 = 0;
global FB_RGB: u64 = 0;
global CLOCK_HZ: u64 = 0;
global DMA_BASE: u64 = 0;
buffer MEMORY_MAP[131072];
buffer MEMORY_INFO[40];
buffer PAGE_ADDRESS[8];

fn graphics_init() -> bool {
    efi_guid(0x9042a9de, 0x23dc, 0x4a38, 0x6a5180d0de7afb96);
    let gop: u64 = efi_locate_protocol();
    if gop == 0 { return false; }
    let mode: u64 = load64(gop + 24);
    if mode == 0 { return false; }
    let info: u64 = load64(mode + 8);
    if info == 0 { return false; }
    let format: u64 = load32(info + 12);
    if format > 1 { return false; }
    FB_BASE = load64(mode + 24);
    FB_SIZE = load64(mode + 32);
    FB_WIDTH = load32(info + 4);
    FB_HEIGHT = load32(info + 8);
    FB_STRIDE = load32(info + 32);
    FB_RGB = 0;
    if format == 0 { FB_RGB = 1; }
    if FB_BASE == 0 || FB_WIDTH < 640 || FB_HEIGHT < 480 { return false; }
    if FB_WIDTH > 1920 || FB_HEIGHT > 1200 || FB_STRIDE < FB_WIDTH { return false; }
    if FB_SIZE < FB_STRIDE * FB_HEIGHT * 4 { return false; }
    return true;
}

fn reserve_dma() {
    # ISA DMAは16MiB未満、64KiB境界をまたがない連続領域を使う。
    store64(addr(PAGE_ADDRESS), 0x00ffffff);
    let status: u64 = call4(load64(EFI_BOOT + 40), 1, 2, 32, addr(PAGE_ADDRESS));
    if status == 0 { DMA_BASE = (load64(addr(PAGE_ADDRESS)) + 65535) & ~65535; }
}

fn leave_firmware() -> bool {
    # GetMemoryMapとExitBootServicesの間でファームウェアを再呼び出ししない。
    let tries: u64 = 0;
    while tries < 3 {
        store64(addr(MEMORY_INFO), len(MEMORY_MAP));
        let status: u64 = call5(load64(EFI_BOOT + 56), addr(MEMORY_INFO), addr(MEMORY_MAP), addr(MEMORY_INFO) + 8, addr(MEMORY_INFO) + 16, addr(MEMORY_INFO) + 24);
        if status != 0 { return false; }
        status = call2(load64(EFI_BOOT + 232), EFI_IMAGE, load64(addr(MEMORY_INFO) + 8));
        if status == 0 { return true; }
        tries = tries + 1;
    }
    return false;
}

fn entry(image: u64, system: u64) -> u64 {
    efi_init(image, system);
    serial("TANEBI95_UEFI_ENTERED\n");
    serial("TANEBI95_SOURCE_LANGUAGE_TANEBI\n");
    if !graphics_init() {
        serial("TANEBI95_GRAPHICS_FAILED\n");
        return 0x8000000000000003;
    }
    reserve_dma();
    let start: u64 = ticks();
    call1(load64(EFI_BOOT + 248), 50000);
    CLOCK_HZ = (ticks() - start) * 20;
    serial("TANEBI95_FRAMEBUFFER_OK\n");
    if !leave_firmware() {
        serial("TANEBI95_EXIT_BOOT_SERVICES_FAILED\n");
        return 0x8000000000000002;
    }
    irq_disable();
    serial("TANEBI95_BARE_METAL_OK\n");
    desktop_main();
    while true { pause(); }
    return 0;
}
