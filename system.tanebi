# This TANEBI program is executed during the native OS build.
let 불꽃 = 3
let 이름 = "TANEBI 95"

print "SYSTEM=" + 이름
print "MOTTO=A SPARK BECOMES A WORLD"
print "COMPUTER=MY COMPUTER"
print "DOCUMENTS=DOCUMENTS"

if 불꽃 == 3 {
    print "STATUS=TANEBI BOOT SCRIPT OK"
} else {
    print "STATUS=BOOT SCRIPT ERROR"
}
