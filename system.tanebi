# 旧文字列マニフェストの出力を保存するホスト用コンパイル例。
# 標準OSビルドでは使用せず、system/*.tanebi を直接コンパイルする。
fn main() {
    let 種火:u64 = 3;
    let 名前:str = "TANEBI 95";

    print("SYSTEM=");
    println(名前);
    println("MOTTO=A SPARK BECOMES A WORLD");
    println("COMPUTER=MY COMPUTER");
    println("DOCUMENTS=DOCUMENTS");

    if 種火 == 3 {
        println("STATUS=TANEBI BOOT SCRIPT OK");
    } else {
        println("STATUS=BOOT SCRIPT ERROR");
    }
}
